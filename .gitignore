# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- gitignore hardening (2026-11-11): never commit secrets or generated files ---
# Secrets and credentials
.env.*
*.env.bak*
*.key
*.p12
*.p8
*.jks
*.keystore
key.properties
*service-account*.json
*-credentials.json
credentials/
*.tfvars
*secret*.local.*
google_request_tokens.json
.netrc
!.env.example
!.env.sample
!.env.template
!*.tfvars.example
# Dependencies, build output, caches and OS junk
node_modules/
.venv/
venv/
env/
__pycache__/
*.pyc
*.egg-info/
.next/
dist/
build/
**/ios/Pods/
**/vendor/bundle/
*.log
coverage/
.expo/
response_cache/
.chrome-profile*/
chrome-profile*/
chrome_profile*/
browser-profile*/
browser_profile*/
user-data-dir/
**/playwright/.auth/
# --- end gitignore hardening ---
