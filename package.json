		"axios": "^1.3.4",
		"bootstrap": "^5.2.3",
		"moment": "^2.29.4",
		"next": "13.2.3",
		"normalize.css": "^8.0.1",
		"react": "18.2.0",
		"react-bootstrap": "^2.7.2",
		"react-dom": "18.2.0",
		"react-serialize": "^0.2.1",
		"styled-components": "^5.3.8",
		"typescript": "4.9.5",
		"yup": "^1.0.2"
	},
