		"check-packages": "yarn clean && yarn compile && yarn test && yarn lint",
		"test-all": "yarn check-format && yarn check-lint && yarn check-types && yarn build",
		"prepare": "husky install"
	},
	"dependencies": {
		"@types/node": "18.14.6",
		"@types/react": "18.0.28",
		"@types/react-dom": "18.0.11",
